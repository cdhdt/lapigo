{{- /*
store/cursor.go renders the store package's cursor codec (spec §7.4, §7.5,
§7.6): the fixed envelope, encoder and decoder every entity's codec is built
on, and then, per entity that declares `list`, that entity's own key struct,
fingerprint constant, encoder and decoder.

One file for the whole package rather than one per entity, because half of
it is schema-independent and the other half is four short declarations per
entity: splitting it would put the envelope in one file and the only code
that ever constructs one in every other file of the package.

Nearly logic-free, per spec §5.1. Every Go type, every identifier, every
quoted literal and -- above all -- the fingerprint and the canonical text it
was computed from come from cursor.go, where a unit test can address them.
The only control flow here is iteration over slices the IR already orders
(spec §5.3) and one {{if}} per sort key for the two per-type differences
the decoder has: whether a decoded value is normalised to UTC, and whether
it carries a pgtype validity flag.
*/ -}}
{{- define "store/cursor.go" -}}
{{template "header" .}}
// Package store's cursor codec (spec §7.4). A cursor is the base64url,
// unpadded, of a JSON object:
//
//	{"v":1,"f":"<fingerprint>","k":{"<column>":<value>, ...}}
//
// `v` is the format version, `f` is a fingerprint of the query shape the
// cursor was minted under -- entity, sort spec and filter set -- and `k`
// carries the sort-key values of the last row the page RETURNED, keyed by
// column name like every other name on the wire (spec §6.9.2).
//
// A cursor is readable, not secret: base64url of JSON is not encryption, and
// the value lands in access logs, Referer headers and browser history. Phase
// 3 has to keep data the caller may not read out of sort and filter columns.
//
// A cursor is also unsigned. Phase 1 ships no HMAC deliberately (spec §7.4):
// a forged cursor grants no unauthorised access, because authorisation
// filters are applied server-side from the request and never from the
// cursor -- it only lands a caller at an arbitrary position within data they
// may already read. What stands between a forged cursor and the database is
// therefore the strict typed decoding below: every member is checked against
// its own sort key's Go type before any value is bound to a query parameter,
// and any failure at all is an error. Never a fallthrough to a looser query,
// never a silent first page, and never a panic.

// cursorFormatVersion is the only value a cursor's `v` member may carry.
// Another value means another shape of `k`, written by a differently
// generated binary, and reading it under this version's types is exactly the
// confusion the member exists to prevent.
const cursorFormatVersion = {{.FormatVersion}}

// ErrInvalidCursor is what every cursor failure wraps, and what a caller
// matches with errors.Is: httpapi answers 400 with code "invalid_cursor"
// (spec §6.9.4). The wrapped text says which check failed and belongs in a
// log line -- an error envelope never carries it, because a response body
// does not describe internals (spec §6.7).
var ErrInvalidCursor = errors.New("invalid cursor")

// cursorEnvelope is that JSON object, with K one entity's key struct.
type cursorEnvelope[K any] struct {
	Version     int    `json:"v"`
	Fingerprint string `json:"f"`
	Keys        K      `json:"k"`
}

// encodeCursor renders keys as a cursor string.
//
// The error return is not decorative: time.Time.MarshalJSON fails for a year
// outside [0, 9999], which a timestamptz column can hold and no validator
// can rule out (spec §7.5). A store that meets one logs this error and
// answers 500 -- never a panic, and never a page whose `next` quietly went
// missing.
func encodeCursor[K any](fingerprint string, keys K) (string, error) {
	buf, err := json.Marshal(cursorEnvelope[K]{
		Version:     cursorFormatVersion,
		Fingerprint: fingerprint,
		Keys:        keys,
	})
	if err != nil {
		return "", fmt.Errorf("encode cursor: %w", err)
	}
	return base64.RawURLEncoding.EncodeToString(buf), nil
}

// decodeCursorKeys decodes encoded and returns its `k` member, having first
// checked everything that can be checked without looking at a value: the
// base64url alphabet, the JSON syntax, the absence of members this code does
// not read, the absence of trailing bytes, the format version and the
// fingerprint. The caller then checks the values themselves.
//
// Unpadded base64url in both directions. It is what encodeCursor emits, and
// accepting the padded spelling as well would give one cursor two forms.
//
// The wrapped decoder error is safe to log: encoding/json validates the
// document's syntax before any value is looked at, so a raw control
// character never reaches a message from here -- it is a syntax error first.
func decodeCursorKeys[K any](encoded string, fingerprint string) (K, error) {
	var keys K

	if encoded == "" {
		// Named rather than left to the JSON decoder, which answers "EOF"
		// for it: a handler reaching here with an empty `after` is a
		// handler that let one through (spec §6.9.4 makes an empty query
		// parameter a 400 of its own), and a log line saying so is worth
		// more than a log line saying EOF.
		return keys, fmt.Errorf("%w: empty", ErrInvalidCursor)
	}

	raw, err := base64.RawURLEncoding.DecodeString(encoded)
	if err != nil {
		return keys, fmt.Errorf("%w: not unpadded base64url", ErrInvalidCursor)
	}

	dec := json.NewDecoder(bytes.NewReader(raw))
	dec.DisallowUnknownFields()
	var env cursorEnvelope[K]
	if err := dec.Decode(&env); err != nil {
		return keys, fmt.Errorf("%w: %s", ErrInvalidCursor, err)
	}
	if dec.More() {
		return keys, fmt.Errorf("%w: trailing bytes after the cursor object", ErrInvalidCursor)
	}
	if env.Version != cursorFormatVersion {
		return keys, fmt.Errorf("%w: format version %d, want %d", ErrInvalidCursor, env.Version, cursorFormatVersion)
	}
	if env.Fingerprint != fingerprint {
		return keys, fmt.Errorf("%w: minted for another query shape", ErrInvalidCursor)
	}
	return env.Keys, nil
}
{{range .Entities}}{{$e := .}}
// {{$e.VarPrefix}}CursorFingerprint pins the query shape a cursor for "{{comment $e.Name}}" is valid
// under (spec §7.4): the truncated SHA-256 of
//
{{- range $e.ShapeLines}}
//	{{comment .}}
{{- end}}
//
// computed when this file was generated, because every input to it is fixed
// then. The entity name is in that text on purpose: revision 1 left it out,
// and two entities sharing a sort and a filter shape then minted
// interchangeable cursors, so one entity's cursor replayed against the other
// (spec §7.4, §12). Change the sort or the filters and the constant changes
// with them, which is what retires the cursors already in flight.
const {{$e.VarPrefix}}CursorFingerprint = {{goString $e.Fingerprint}}

// {{$e.VarPrefix}}CursorKeys is the `k` member of a cursor for "{{comment $e.Name}}": one member per
// sort key, in sort order, each named after its column (spec §6.9.2).
//
// Every member is a pointer, and that is the presence check. encoding/json
// leaves it nil both for a member that never appeared and for one carrying
// the literal null, and both are invalid here -- a sort key is never
// nullable (spec §3.3 rule 3), so a null has nothing it could mean.
type {{$e.VarPrefix}}CursorKeys struct {
{{- range $e.Keys}}
	{{.GoName}} *{{.GoType}} {{.Tag}}
{{- end}}
}

// {{$e.VarPrefix}}Cursor is a decoded cursor for "{{comment $e.Name}}": the sort-key values of the last
// row a page returned, type-checked, in the order the keyset predicate binds
// them (spec §7.1).
type {{$e.VarPrefix}}Cursor struct {
{{- range $e.Keys}}
	{{.GoName}} {{.GoType}}
{{- end}}
}

// encode{{$e.GoName}}Cursor builds the cursor for a page of "{{comment $e.Name}}" rows ending at
// row.
//
// row is the last row the page RETURNS -- never the extra row the limit+1
// peek fetched (spec §7.6). A cursor built from the peeked row skips exactly
// one row per page boundary: invisible on a demo, and a hole in every full
// listing in production.
{{- if $e.HasTimeKey}}
//
// Timestamps follow spec §7.5. The values are the time.Time pgx scanned into
// row (rule 1): the driver has already quantised them to the microsecond
// timestamptz stores, so they compare exactly the way the keyset predicate
// needs, which a time reconstructed from a formatted string does not. They
// are normalised to UTC before serialising (rule 2) -- the other half of
// that rule is not here and cannot be: pgx scans timestamptz into time.Local
// unless the pool's connection config sets ScanLocation: time.UTC, which
// cmd/api/main.go does where the pool is built, and both halves are needed
// for two hosts in different zones to mint the same bytes for one instant.
// Rule 3 needs no code at all: nothing in this file ever compares cursor
// strings, only the values they decode to.
{{- end}}
func encode{{$e.GoName}}Cursor(row *model.{{$e.GoName}}) (string, error) {
	if row == nil {
		return "", fmt.Errorf("encode {{comment $e.Name}} cursor: nil row")
	}
{{- range $e.Keys}}
	{{.Local}} := {{.EncodeExpr}}
{{- end}}
	return encodeCursor({{$e.VarPrefix}}CursorFingerprint, {{$e.VarPrefix}}CursorKeys{
{{- range $e.Keys}}
		{{.GoName}}: &{{.Local}},
{{- end}}
	})
}

// decode{{$e.GoName}}Cursor decodes a cursor for "{{comment $e.Name}}", as the `after` query
// parameter carries it (spec §6.9.4).
//
// Strict, member by member, before anything is bound: the envelope's own
// checks run in decodeCursorKeys, and then every key must be present, must
// have decoded into its sort key's Go type -- encoding/json is what enforces
// that, and it fails rather than coercing. Every failure wraps
// ErrInvalidCursor, which httpapi answers with 400 "invalid_cursor" (spec
// §7.4: a well-formed cursor carrying a string where a timestamp belongs is
// a 400, not a pgx error surfacing as a 500).
{{- if $e.HasValidKey}}
//
// A pgtype value left in its invalid state is refused as well: it binds as
// NULL, and a keyset comparison against NULL compares unknown, which is an
// empty page rather than an error.
{{- end}}
//
// A rejected cursor returns the ZERO value, never the members that had
// already checked out. A caller that mishandled the error would otherwise be
// handed a position that is half a page's and half nothing.
func decode{{$e.GoName}}Cursor(encoded string) ({{$e.VarPrefix}}Cursor, error) {
	var out {{$e.VarPrefix}}Cursor

	keys, err := decodeCursorKeys[{{$e.VarPrefix}}CursorKeys](encoded, {{$e.VarPrefix}}CursorFingerprint)
	if err != nil {
		return {{$e.VarPrefix}}Cursor{}, fmt.Errorf("{{comment $e.Name}} cursor: %w", err)
	}
{{range $e.Keys}}
	if keys.{{.GoName}} == nil {
		return {{$e.VarPrefix}}Cursor{}, fmt.Errorf("{{comment $e.Name}} cursor: %w: member %q is missing or null", ErrInvalidCursor, {{goString .Column}})
	}
{{- if .CheckValid}}
	if !keys.{{.GoName}}.Valid {
		// Unreachable while the member above is a pointer, and kept: the
		// literal null sets that pointer to nil without pgtype's own
		// Unmarshaler ever running, and pgtype's own Unmarshaler accepts
		// null as a valid-less value. This is what stands between that
		// value and a seek against NULL -- which compares unknown and
		// returns an empty page -- if either half changes.
		return {{$e.VarPrefix}}Cursor{}, fmt.Errorf("{{comment $e.Name}} cursor: %w: member %q did not decode to a usable value", ErrInvalidCursor, {{goString .Column}})
	}
{{- end}}
{{- if .Normalise}}
	out.{{.GoName}} = keys.{{.GoName}}{{.Normalise}}
{{- else}}
	out.{{.GoName}} = *keys.{{.GoName}}
{{- end}}
{{- end}}

	return out, nil
}
