{{- /*
hooks/entity.go renders one entity's hook interface and its embeddable
no-op implementation (spec §6.2 escape hatch 1, §6.3).

Only called for an entity with at least one write operation (spec §5.6):
plan.go skips this template entirely for an entity with none, so every
Entity this template sees has a non-empty hookOperations(.).

Nearly logic-free, per spec §5.1: hookOperations does the one decision this
file needs -- which method trios exist, and what BeforeX's third parameter
looks like for each -- so the template only substitutes names.
*/ -}}
{{- define "hooks/entity.go" -}}
{{template "header" .}}
{{- with $e := .Entity}}
// {{$e.GoName}}Hooks is the generated hook interface for entity "{{comment $e.Name}}"
// (spec §6.3). Every method runs inside the store's write transaction and
// may abort it by returning an error -- a *hooks.Error to choose the
// response's own status and code, any other error for the 500 it deserves
// (spec §6.4, §6.7). The *Committed variants run after the transaction has
// committed, return nothing, and are at-most-once: a crash between commit
// and hook loses the call, and a failure inside it is logged, not retried
// (spec §6.4).
type {{$e.GoName}}Hooks interface {
{{- range hookOperations $e}}
	Before{{.Name}}(ctx context.Context, tx pgx.Tx, {{.BeforeParam}}) error
	After{{.Name}}(ctx context.Context, tx pgx.Tx, a *model.{{$e.GoName}}) error
	After{{.Name}}Committed(ctx context.Context, a *model.{{$e.GoName}})
{{end -}}
}

// Noop{{$e.GoName}}Hooks implements {{$e.GoName}}Hooks with every method a no-op.
// Embed it to implement only the methods a project needs -- adding a method
// to {{$e.GoName}}Hooks in a later release extends Noop{{$e.GoName}}Hooks along with it and
// does not break an embedder's build (spec §6.3).
type Noop{{$e.GoName}}Hooks struct{}
{{range hookOperations $e}}
func (Noop{{$e.GoName}}Hooks) Before{{.Name}}(context.Context, pgx.Tx, {{.BeforeArg}}) error {
	return nil
}

func (Noop{{$e.GoName}}Hooks) After{{.Name}}(context.Context, pgx.Tx, *model.{{$e.GoName}}) error {
	return nil
}

func (Noop{{$e.GoName}}Hooks) After{{.Name}}Committed(context.Context, *model.{{$e.GoName}}) {}
{{end -}}
{{- end}}
{{- end -}}
